# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/reclib

# Secreto para sesiones (generar con: openssl rand -base64 64)
SESSION_SECRET=tu-secreto-aqui

# OpenAI API Key (obtener en https://platform.openai.com/api-keys)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-proj-xxx

# Dominio público (desarrollo: localhost, producción: tu dominio)
EXPO_PUBLIC_DOMAIN=http://localhost:5000

# Puerto del servidor
PORT=5000
